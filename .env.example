# The project uses SQLite only.
DATABASE_URL=sqlite:///./data/clinical_compass.db
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=0
COOKIE_SAMESITE=lax
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3125,http://127.0.0.1:3125

# Separate random secret for validating incoming MAX webhooks.
# The MAX API key is never stored here; it is read only from BotMax/MaxAPI.txt.
MAX_WEBHOOK_SECRET=replace-with-a-separate-random-webhook-secret

# Local clinical drafting model. The model never makes medication eligibility decisions.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
PARTNER_MEDICATION_PATH=./config/partner_medication.json
GRLS_REGISTRY_PATH=./reference_data/Svedeniya_GRLS_127_UTF_8.json

# Public legal details shown on the privacy, consent and cookie pages.
NEXT_PUBLIC_OPERATOR_NAME=Полное наименование оператора персональных данных
NEXT_PUBLIC_OPERATOR_ADDRESS=Юридический или почтовый адрес оператора
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@example.ru
NEXT_PUBLIC_OPERATOR_REGISTRY=ИНН / ОГРН (если применимо)
